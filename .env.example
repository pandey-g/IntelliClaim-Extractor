# Application
APP_NAME=IntelliClaim Extractor
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_KEYS=dev-api-key-1,dev-api-key-2
RATE_LIMIT_PER_MINUTE=60

# Database
DATABASE_URL=postgresql+asyncpg://intelliclaim:intelliclaim@localhost:5432/intelliclaim
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage
DOCUMENT_STORAGE_PATH=/var/lib/intelliclaim/documents
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,tif

# OCR / ML
TESSERACT_CMD=/usr/bin/tesseract
LAYOUTLM_MODEL_NAME=microsoft/layoutlmv3-base
LAYOUTLM_DEVICE=cpu

# Observability
OTEL_ENABLED=true
OTEL_SERVICE_NAME=intelliclaim-extractor
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true
